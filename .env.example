# ============================================================
#  Terra Backend — Variables d'environnement
#  Copier ce fichier en .env et remplir les valeurs
# ============================================================

# Serveur
PORT=5000
NODE_ENV=development

# Base de données MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=ton_mot_de_passe_mysql
DB_NAME=terra

# JWT (JSON Web Token) — clé secrète pour signer les tokens
JWT_SECRET=terra_super_secret_key_change_en_production
JWT_EXPIRES_IN=7d

# Upload fichiers
UPLOAD_PATH=uploads/listings
MAX_FILE_SIZE=5242880

# URL du frontend (pour CORS)
CLIENT_URL=http://localhost:5173

# Email (notifications réservations)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre_email@example.com
SMTP_PASS=votre_mot_de_passe
MAIL_FROM=noreply@terra.com
ADMIN_NOTIFY_EMAIL=admin@terra.com
